# Development environment defaults (issue #60).
#
# Layering (lowest → highest): schema defaults → this file → .env/.env.local
# (git-ignored, your machine's real values) → actual process environment.
# Values here are safe placeholders for local development only.

# Server
LOG_LEVEL=debug
DB_LOG_QUERIES=false

# Database (local docker-compose instance)
DATABASE_URL=postgresql://user:password@localhost:5432/dorisio

# Redis
REDIS_URL=redis://localhost:6379
RATE_LIMIT_STORE=memory

# Stellar testnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Feature flags (defaults; override with real environment variables)
FEATURE_EMAIL_VERIFICATION=true
FEATURE_ANALYTICS=true
FEATURE_WEBHOOKS=true
FEATURE_EXPORTS=true
FEATURE_MAINTENANCE_MODE=false

# Local development secrets — replace in your git-ignored .env / .env.local.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
SENDGRID_API_KEY=
EMAIL_FROM=notifications@example.com
