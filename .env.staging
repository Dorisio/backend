# Staging environment defaults (issue #60).
#
# Committed file — contains ONLY placeholders and {{ SECRET_NAME }} references.
# Real values come from the deployment environment or a secrets provider.

# Server
LOG_LEVEL=info
RATE_LIMIT_STORE=redis

# Database and auth secrets are injected — unresolved references fail startup.
DATABASE_URL={{ DATABASE_URL }}
JWT_SECRET={{ JWT_SECRET }}

# Redis
REDIS_URL={{ REDIS_URL }}

# Stellar testnet for staging
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Feature flags
FEATURE_EMAIL_VERIFICATION=true
FEATURE_ANALYTICS=true
FEATURE_WEBHOOKS=true
FEATURE_EXPORTS=true
FEATURE_MAINTENANCE_MODE=false

DB_SSL_MODE=verify-full
DB_SSL_REJECT_UNAUTHORIZED=true
