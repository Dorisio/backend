{
  "name": "dorisio-backend",
  "version": "0.1.0",
  "description": "Dorisio backend - Payment orchestration and Stellar integration",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:migrate": "tsx src/db/run-migrations.ts --up",
    "db:migrate:dry-run": "tsx src/db/run-migrations.ts --dry-run",
    "db:rollback": "tsx src/db/run-migrations.ts --down",
    "worker": "tsx src/lib/workers/index.ts",
    "jobs:status": "tsx src/lib/jobs/cli-status.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^7.10.0",
    "@stellar/stellar-sdk": "^17.1.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "generic-pool": "^3.8.2",
    "ioredis": "6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.0",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^9.3.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "tsx": "^4.17.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
