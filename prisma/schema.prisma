generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("fan")
  verified  Boolean  @default(false)
  notificationPreferences Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   Creator?
  wallets   Wallet[]
  tips      Tip[]
  payments  Payment[]

  // Referral program
  referralCode        ReferralCode?
  referredAs          Referral?              @relation("RefereeUser")
  commissionsEarned   ReferralCommission[]   @relation("ReferrerUser")
}

model Creator {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username    String  @unique
  displayName String?
  bio         String?
  avatar      String?

  verified Boolean @default(false)
  isPublic Boolean @default(true)

  totalEarnings  Float @default(0)
  pendingBalance Float @default(0)
  
  tips      Tip[]    @relation("CreatorTips")
  webhooks  Webhook[]
  freezes   AccountFreeze[]
  payments  Payment[]
  payouts   Payout[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verified, isPublic])
  // Creator discovery feeds: visibility filter + deterministic keyset order.
  @@index([isPublic, createdAt(sort: Desc), id(sort: Desc)], map: "idx_creator_public_createdAt")
  // Leaderboard / "top creators" ordering after the visibility filter.
  @@index([isPublic, verified, totalEarnings(sort: Desc)], map: "idx_creator_public_verified_earnings")
  // Global top-earners ranking (no filters).
  @@index([totalEarnings(sort: Desc)], map: "idx_creator_totalEarnings")
}

model Wallet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  publicKey String  @unique
  name      String?
  verified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, verified])
}

model Tip {
  id         String @id @default(cuid())
  fromUserId String
  fromUser   User   @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  creatorId String
  creator   Creator @relation("CreatorTips", fields: [creatorId], references: [id], onDelete: Cascade)

  amount  Float
  message String?

  status          String  @default("pending")
  transactionHash String? @unique
  // Optimistic locking guard: every status write must match the version it
  // read and increments it, so concurrent confirmations cannot both succeed.
  version         Int     @default(0)
  // Client-supplied idempotency key for tip/payment submission; a retry
  // returns the original tip instead of creating a duplicate charge.
  idempotencyKey  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralCommission ReferralCommission?

  @@index([creatorId, status, createdAt])
  @@index([fromUserId, createdAt])
  @@index([status])
  // Unfiltered creator tip history ordered newest-first (keyset friendly).
  @@index([creatorId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_tip_creator_createdAt")
  // User tip history filtered by status.
  @@index([fromUserId, status, createdAt(sort: Desc)], map: "idx_tip_fromUser_status_createdAt")
  // Global status sweeps (reconciliation workers) ordered by time.
  @@index([status, createdAt], map: "idx_tip_status_createdAt")
  // "Top supporters" aggregation: filter then group by supporter without a sort step.
  @@index([creatorId, status, fromUserId], map: "idx_tip_creator_status_fromUser")
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Tracks revoked/rotated refresh tokens by their JWT id (jti) so that a
// leaked or already-used refresh token cannot be replayed.
model BlacklistedRefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  userId    String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([userId])
}

model Webhook {
  id        String  @id @default(cuid())
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  url    String
  events String[] // tip.created, tip.confirmed, tip.failed, payout.completed
  secret String // HMAC secret for signature verification
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]

  @@index([creatorId])
  // Webhook listing per creator, newest first.
  @@index([creatorId, createdAt(sort: Desc)], map: "idx_webhook_creator_createdAt")
  // Delivery worker only fans out to active endpoints.
  @@index([creatorId, active, createdAt(sort: Desc)], map: "idx_webhook_creator_active_createdAt")
}

model WebhookEvent {
  id        String  @id @default(cuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  eventType String // tip.created, tip.confirmed, etc.
  payload   String // JSON payload
  status    String  @default("pending") // pending, delivered, failed
  attempts  Int     @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([webhookId, status, createdAt(sort: Desc)])
  @@index([webhookId])
  @@index([status])
  @@index([webhookId, status])
  @@index([createdAt])
  // Delivery log listing per webhook, newest first.
  @@index([webhookId, createdAt(sort: Desc)], map: "idx_webhookEvent_webhook_createdAt")
  // Retry sweeps filter by status and process oldest events first.
  @@index([status, createdAt], map: "idx_webhookEvent_status_createdAt")
}

// A payment processed by an external provider (Stripe et al). Raw card data is
// never stored — only provider references and tokenized intent ids.
model Payment {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  provider    String // stripe
  method      String // card | wallet | crypto
  providerRef String? // provider payment intent reference
  amount      Float
  currency    String  @default("USD")
  status      String  @default("pending") // pending, requires_action, processing, succeeded, failed, canceled, refunded, partially_refunded, disputed
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events  PaymentEvent[]
  refunds Refund[]

  @@index([userId, createdAt])
  @@index([creatorId])
  @@index([status])
  @@index([providerRef])
}

// Immutable audit trail for a payment. Every state change and provider callback
// appends an event so the full history can be reconstructed.
model PaymentEvent {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  type   String // payment.created, payment.succeeded, payment.failed, refund.created, chargeback.created, webhook.received
  actor  String? // user id, "system" or "provider"
  data   Json?

  // Provider event id — unique so webhook redelivery is idempotent.
  providerEventId String? @unique

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([type])
}

model Refund {
  id             String  @id @default(cuid())
  paymentId      String
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  idempotencyKey String  @unique

  amount       Float
  currency     String  @default("USD")
  reason       String?
  status       String  @default("pending") // pending, succeeded, failed
  providerRef  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

model WalletFlag {
  id      String @id @default(cuid())
  address String @unique

  reason   String
  severity String // low, medium, high, critical
  notes    String?

  flaggedBy  String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([resolved, address])
  @@index([resolved, createdAt(sort: Desc)])
  @@index([resolved])
  @@index([severity])
  // Moderation queue: open flags ordered by severity then recency.
  @@index([resolved, severity, createdAt(sort: Desc)], map: "idx_walletFlag_resolved_severity_createdAt")
}

model AccountFreeze {
  id        String  @id @default(cuid())
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  reason    String
  notes     String?
  duration  Int? // hours, null = indefinite
  expiresAt DateTime?

  frozenBy   String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, resolved, expiresAt])
  @@index([creatorId])
  @@index([resolved])
  @@index([expiresAt])
  // Freeze history per creator: filter by resolution state, newest first.
  @@index([creatorId, resolved, createdAt(sort: Desc)], map: "idx_accountFreeze_creator_resolved_createdAt")
  // Expiry sweep: only active freezes, oldest expiry first.
  @@index([resolved, expiresAt], map: "idx_accountFreeze_resolved_expiresAt")
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

// ─── Referral Program ────────────────────────────────────────────────────────

// Commission tier configuration (admin-controlled).
// Admins can define named tiers with different commission rates.
// Each user is assigned a tier; default tier is applied if none specified.
model ReferralTier {
  id          String @id @default(cuid())
  name        String @unique  // e.g. "standard", "silver", "gold"
  description String?
  // Commission as a fraction (e.g. 0.05 = 5%)
  commissionRate Float
  isDefault   Boolean @default(false)

  referralCodes ReferralCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

// A unique referral code owned by a user. Each user may have at most one
// active code at a time. The code is a short, URL-safe alphanumeric string.
model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String  @unique
  tierId    String?
  tier      ReferralTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  isActive  Boolean @default(true)
  // Soft fraud-lock: admin or system can deactivate without deleting history
  lockedAt  DateTime?
  lockReason String?

  usageCount Int @default(0)

  referrals    Referral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([code])
  // Dashboard: referrer looks up their own code list newest-first.
  @@index([userId, createdAt(sort: Desc)], map: "idx_referralCode_user_createdAt")
}

// A single referral event: a new user who signed up via a referral code.
// One referee -> one referral record.
model Referral {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  // The user who was referred (referee)
  refereeId String
  referee   User   @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Cascade)

  // Depth starts at 1 for a direct referral. Used to enforce max-depth guard.
  depth     Int @default(1)

  // Lifecycle: pending → converted → rewarded | fraud
  status    String @default("pending")  // pending, converted, rewarded, fraud

  // When the referee completed the qualifying action (e.g. first confirmed tip)
  convertedAt DateTime?

  commissions ReferralCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate referral for the same referee
  @@unique([refereeId])
  @@index([referralCodeId, status])
  @@index([refereeId])
  @@index([status, createdAt])
  // Referrer dashboard: all referrals for a given code, newest first.
  @@index([referralCodeId, createdAt(sort: Desc)], map: "idx_referral_code_createdAt")
}

// A commission earned by a referrer when their referee's tip is confirmed.
// Multiple commissions may exist per referral (one per qualifying tip).
model ReferralCommission {
  id         String   @id @default(cuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  // The tip that triggered this commission
  tipId  String
  tip    Tip    @relation(fields: [tipId], references: [id], onDelete: Cascade)

  // Referrer (denormalized for query efficiency)
  referrerId String
  referrer   User   @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)

  amount         Float   // Commission amount (computed from tip.amount * commissionRate)
  commissionRate Float   // Snapshot of the rate at the time of calculation
  currency       String  @default("XLM")

  // pending → paid | failed
  status     String @default("pending")
  paidAt     DateTime?
  failReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipId])  // One commission per tip (idempotent)
  @@index([referrerId, status])
  @@index([referralId, status])
  @@index([status, createdAt])
  // Affiliate payout sweep: pending commissions for a referrer, oldest first.
  @@index([referrerId, status, createdAt], map: "idx_referralCommission_referrer_status_createdAt")
}

model Payout {
  id         String       @id @default(cuid())
  creatorId  String
  creator    Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  amount          Float
  status          PayoutStatus @default(pending)
  transactionHash String?      @unique
  walletAddress   String

  errorMessage String?
  retryCount    Int      @default(0)
  nextRetryAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, status])
  @@index([status, nextRetryAt])
  @@index([createdAt])
  // Payout history per creator, newest first.
  @@index([creatorId, createdAt(sort: Desc)], map: "idx_payout_creator_createdAt")
  // Retry worker: failed payouts ordered by next retry time.
  @@index([status, nextRetryAt], map: "idx_payout_status_nextRetryAt")
  @@index([transactionHash])
}
